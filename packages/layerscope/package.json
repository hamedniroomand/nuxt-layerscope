{
  "name": "nuxt-layerscope",
  "version": "0.12.1",
  "description": "Linter for Nuxt layer boundaries that sees auto-imports",
  "keywords": [
    "architecture",
    "auto-imports",
    "boundaries",
    "cli",
    "layer-boundaries",
    "lint",
    "linter",
    "nuxt",
    "nuxt-layers",
    "nuxt-module"
  ],
  "homepage": "https://github.com/hamedniroomand/nuxt-layerscope/tree/main/packages/layerscope#readme",
  "bugs": "https://github.com/hamedniroomand/nuxt-layerscope/issues",
  "license": "MIT",
  "author": "Hamed Niroomand",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/hamedniroomand/nuxt-layerscope.git",
    "directory": "packages/layerscope"
  },
  "bin": {
    "layerscope": "./dist/bin.mjs"
  },
  "files": [
    "dist",
    "schema",
    "CHANGELOG.md"
  ],
  "type": "module",
  "imports": {
    "#bench/*": "./bench/*",
    "#src/*": "./src/*",
    "#test/*": "./test/*"
  },
  "exports": {
    ".": {
      "types": "./dist/index.d.mts",
      "default": "./dist/index.mjs"
    },
    "./api": {
      "types": "./dist/api.d.mts",
      "default": "./dist/api.mjs"
    },
    "./eslint": {
      "types": "./dist/eslint.d.mts",
      "default": "./dist/eslint.mjs"
    },
    "./schema/report-1.json": "./schema/report-1.json"
  },
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "bench": "node bench/run.ts",
    "bench:generate": "node bench/generate.ts",
    "build": "node -e \"require('node:fs').rmSync('../devtools-client/dist', { recursive: true, force: true })\" && vp run @layerscope/devtools-client#bundle && vp pack",
    "test": "vp test",
    "tarball": "vp run build && vp pm pack --pack-destination ../../.release"
  },
  "dependencies": {
    "@dagrejs/dagre": "^3.1.1",
    "@jridgewell/sourcemap-codec": "^1.6.0",
    "@nuxt/kit": "^4.6.2",
    "@nuxt/schema": "^4.6.2",
    "@vue/compiler-sfc": "^3.5.44",
    "@vue/shared": "3.5.44",
    "cac": "^7.1.0",
    "chokidar": "^5.0.0",
    "globals": "^17.13.0",
    "h3": "^1.15.11",
    "ignore": "^7.0.12",
    "import-meta-resolve": "^4.2.0",
    "jiti": "^2.7.0",
    "mlly": "^1.8.2",
    "oxc-parser": "^0.154.0",
    "oxc-walker": "^1.1.1",
    "pathe": "^2.0.3",
    "tinyglobby": "^0.2.17"
  },
  "devDependencies": {
    "@modelcontextprotocol/sdk": "1.32.1",
    "@types/node": "^26.6.5",
    "ajv": "^8.20.0",
    "eslint": "^10.13.0",
    "typescript-eslint": "^8.71.2",
    "unimport": "7.0.2",
    "unrouting": "0.2.3",
    "vite-plus": "catalog:",
    "vue-eslint-parser": "^10.4.1"
  },
  "peerDependencies": {
    "eslint": ">=9.0.0",
    "nuxt": "^3.12.0 || ^4.0.0"
  },
  "peerDependenciesMeta": {
    "nuxt": {
      "optional": true
    },
    "eslint": {
      "optional": true
    }
  },
  "engines": {
    "node": ">=22.18.0"
  }
}
