{
  "name": "nuxt-layerscope",
  "version": "0.3.1",
  "description": "Layer boundary checks for Nuxt apps that see auto-imports",
  "keywords": [
    "architecture",
    "auto-imports",
    "boundaries",
    "cli",
    "lint",
    "nuxt",
    "nuxt-layers",
    "nuxt-module"
  ],
  "homepage": "https://github.com/hamedniroomand/nuxt-layerscope/tree/main/packages/layerscope#readme",
  "bugs": "https://github.com/hamedniroomand/nuxt-layerscope/issues",
  "license": "MIT",
  "author": "Hamed Niroomand",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/hamedniroomand/nuxt-layerscope.git",
    "directory": "packages/layerscope"
  },
  "bin": {
    "layerscope": "./dist/bin.mjs"
  },
  "files": [
    "dist",
    "schema",
    "CHANGELOG.md"
  ],
  "type": "module",
  "imports": {
    "#src/*": "./src/*",
    "#test/*": "./test/*"
  },
  "exports": {
    ".": {
      "types": "./dist/index.d.mts",
      "default": "./dist/index.mjs"
    },
    "./api": {
      "types": "./dist/api.d.mts",
      "default": "./dist/api.mjs"
    },
    "./eslint": {
      "types": "./dist/eslint.d.mts",
      "default": "./dist/eslint.mjs"
    },
    "./schema/report-1.json": "./schema/report-1.json"
  },
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "build": "vp pack && vp build --config vite.client.config.ts",
    "check:client": "vue-tsc --noEmit -p src/devtools/client/tsconfig.json",
    "test": "vp test",
    "tarball": "vp run build && vp pm pack --pack-destination ../../.release"
  },
  "dependencies": {
    "@dagrejs/dagre": "^3.1.1",
    "@nuxt/kit": "^4.5.2",
    "@nuxt/schema": "^4.5.2",
    "@vue/compiler-sfc": "^3.5.43",
    "cac": "^7.0.0",
    "chokidar": "^5.0.0",
    "globals": "^17.13.0",
    "h3": "^1.15.11",
    "jiti": "^2.7.0",
    "oxc-parser": "^0.152.0",
    "oxc-walker": "^1.1.1",
    "pathe": "^2.0.3",
    "tinyglobby": "^0.2.17"
  },
  "devDependencies": {
    "@modelcontextprotocol/sdk": "1.32.1",
    "@types/node": "^26.6.4",
    "@vitejs/plugin-vue": "6.0.9",
    "@vue/test-utils": "^2.5.1",
    "ajv": "^8.20.0",
    "axe-core": "^4.13.0",
    "eslint": "^10.12.0",
    "happy-dom": "^20.14.5",
    "typescript-eslint": "^8.71.0",
    "vite-plus": "catalog:",
    "vue": "3.5.43",
    "vue-eslint-parser": "^10.4.1",
    "vue-tsc": "^3.3.12"
  },
  "peerDependencies": {
    "eslint": ">=9.0.0",
    "nuxt": "^3.12.0 || ^4.0.0"
  },
  "peerDependenciesMeta": {
    "nuxt": {
      "optional": true
    },
    "eslint": {
      "optional": true
    }
  },
  "engines": {
    "node": ">=22.18.0"
  }
}
