{
  "name": "nuxt-layerscope-monorepo",
  "private": true,
  "type": "module",
  "scripts": {
    "ready": "vp check && vp run nuxt-layerscope#check:client && vp test && vp run -r build",
    "dev": "vp run docs#dev",
    "build": "vp run nuxt-layerscope#build",
    "tarball": "vp run nuxt-layerscope#tarball",
    "docs:dev": "vp run docs#dev",
    "docs:build": "vp run docs#build",
    "docs:preview": "vp run docs#preview",
    "lint": "vp lint",
    "format": "vp format",
    "test": "vp test",
    "prepare": "vp config",
    "playground": "vp run nuxt-layerscope#build && vp run playground#dev",
    "example:verify": "vp run nuxt-layerscope#build && node scripts/verify-example.mjs",
    "changeset": "changeset",
    "changeset:version": "changeset version && node scripts/sync-example-range.mjs && vp fmt"
  },
  "devDependencies": {
    "@changesets/changelog-github": "^1.0.1",
    "@changesets/cli": "^3.0.3",
    "@commitlint/cli": "^21.2.3",
    "@commitlint/config-conventional": "^21.2.3",
    "@vitest/coverage-v8": "catalog:",
    "playwright-core": "^1.64.0",
    "vite-plus": "catalog:",
    "vitest": "catalog:"
  },
  "engines": {
    "node": ">=22.18.0"
  },
  "packageManager": "pnpm@12.10.1"
}
